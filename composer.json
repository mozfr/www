{
  "require": {
    "cecil/cecil": "^9.0"
  },
  "config": {
    "process-timeout": 0
  },
  "scripts": {
    "cecil": "./vendor/bin/cecil \"$@\"",
    "serve:dev": [
      "@putenv CECIL_ENV=dev",
      "./vendor/bin/cecil serve --open ./source"
    ],
    "serve:prod": [
      "@putenv CECIL_ENV=prod",
      "./vendor/bin/cecil serve --open ./source"
    ]
  }
}
